{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Vite development server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--strictPort"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$",
					"message": 0
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^> .* dev$",
					"endsPattern": "http://127\\.0\\.0\\.1:5173/"
				}
			}
		}
	]
}